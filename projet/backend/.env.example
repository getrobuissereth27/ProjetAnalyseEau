# Copier ce fichier en ".env" et remplir les vraies valeurs (ne jamais commiter le .env réel)

# Local : mongodb://127.0.0.1:27017/eau
# Atlas : mongodb+srv://<utilisateur>:<mot_de_passe>@<cluster>.mongodb.net/eau
MONGODB_URI=mongodb://127.0.0.1:27017/eau

JWT_SECRET=change-moi-en-une-longue-chaine-aleatoire

PORT=3000

# Adresse du frontend autorisee a appeler l'API
CORS_ORIGIN=http://localhost:5173

NODE_ENV=development

# --- Envoi d'email pour les alertes (optionnel) ---
# Si SMTP_HOST est vide/absent, l'envoi d'email est simplement desactive :
# les alertes continuent de fonctionner normalement (creation, fermeture de
# vanne...), seul l'email n'est pas envoye (un message s'affiche dans les logs
# du backend a la place). Exemple avec Gmail (necessite un "mot de passe
# d'application", pas le mot de passe du compte) :
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=alertes@aquasuivi.local
