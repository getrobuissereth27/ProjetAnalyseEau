# Copier ce fichier en ".env" et remplir les vraies valeurs (ne jamais commiter le .env réel)

# Local : mongodb://127.0.0.1:27017/eau
# Atlas : mongodb+srv://<utilisateur>:<mot_de_passe>@<cluster>.mongodb.net/eau
MONGODB_URI=mongodb://127.0.0.1:27017/eau

JWT_SECRET=change-moi-en-une-longue-chaine-aleatoire

PORT=3000

# Adresse du frontend autorisee a appeler l'API
CORS_ORIGIN=http://localhost:5173

NODE_ENV=development

# SMTP optionnel : si absent, les emails d'alerte sont journalisés dans les logs
# au lieu d'être réellement envoyés (pratique en développement).
# SMTP_HOST=smtp.exemple.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=alertes@surveillance-eau.local
